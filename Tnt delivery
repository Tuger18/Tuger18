<meta name="description" content="Contact TNT PRESS DELIVERY in Pennsylvania for delivery and logistics inquiries.">

<meta name="theme-color" content="#101820">

<style>
:root {
  --orange: #ff681f;
  --dark: #101820;
  --black: #080d12;
  --white: #ffffff;
  --gray: #68717b;
  --light: #f4f6f8;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: var(--dark);
  line-height: 1.6;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

a {
  text-decoration: none;
  color: inherit;
}

/* HEADER */

header {
  background: var(--dark);
  color: white;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.navbar {
  min-height: 82px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 25px;
  font-weight: 900;
  letter-spacing: 1px;
}

.logo span {
  color: var(--orange);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 30px;
}

.nav-links a {
  color: white;
  font-size: 14px;
  font-weight: bold;
}

.nav-links a:hover {
  color: var(--orange);
}

.menu-btn {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 28px;
  cursor: pointer;
}

/* HERO */

.hero {
  min-height: 620px;
  display: flex;
  align-items: center;
  color: white;

  background:
    linear-gradient(90deg, rgba(0,0,0,.9), rgba(0,0,0,.35)),
    url("https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1800&q=85")
    center/cover no-repeat;
}

.hero-content {
  max-width: 720px;
  padding: 90px 0;
}

.tag {
  color: var(--orange);
  font-weight: bold;
  letter-spacing: 3px;
  font-size: 13px;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(42px, 6vw, 75px);
  line-height: 1.08;
  margin: 22px 0;
  font-weight: 900;
}

.hero h1 span {
  color: var(--orange);
}

.hero p {
  font-size: 18px;
  color: #eeeeee;
  margin-bottom: 30px;
  max-width: 600px;
}

.btn {
  display: inline-block;
  background: var(--orange);
  color: white;
  padding: 15px 28px;
  border-radius: 4px;
  font-weight: bold;
  border: 2px solid var(--orange);
  cursor: pointer;
  transition: .3s;
}

.btn:hover {
  background: transparent;
  color: var(--orange);
}

.btn-outline {
  background: transparent;
  border-color: white;
  margin-left: 10px;
}

.btn-outline:hover {
  background: white;
  color: var(--dark);
}

/* INTRO */

.intro {
  text-align: center;
  padding: 85px 0;
}

.section-title {
  font-size: 36px;
  font-weight: 900;
  margin: 12px 0 20px;
}

.section-title span {
  color: var(--orange);
}

.intro p {
  max-width: 780px;
  margin: auto;
  color: var(--gray);
}

/* SERVICES */

.services {
  background: var(--light);
  padding: 85px 0;
}

.heading {
  text-align: center;
  margin-bottom: 45px;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.service-card {
  background: white;
  padding: 35px 28px;
  box-shadow: 0 5px 25px rgba(0,0,0,.05);
  border-bottom: 4px solid transparent;
  transition: .3s;
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: var(--orange);
}

.service-icon {
  font-size: 42px;
  margin-bottom: 15px;
}

.service-card h3 {
  margin-bottom: 12px;
  font-size: 21px;
}

.service-card p {
  color: var(--gray);
  font-size: 14px;
}

/* ABOUT */

.about {
  padding: 90px 0;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 55px;
  align-items: center;
}

.about-image img {
  width: 100%;
  display: block;
  border-radius: 5px;
}

.about-text p {
  color: var(--gray);
  margin: 18px 0;
}

.about-list {
  list-style: none;
  margin: 20px 0;
}

.about-list li {
  margin: 12px 0;
  font-weight: bold;
}

.about-list li::before {
  content: "✓";
  color: var(--orange);
  margin-right: 12px;
}

/* WHY CHOOSE US */

.why-us {
  background: var(--dark);
  color: white;
  padding: 80px 0;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  text-align: center;
}

.why-card {
  padding: 25px;
}

.why-card h3 {
  color: var(--orange);
  margin-bottom: 12px;
}

/* CTA */

.cta {
  background: var(--orange);
  color: white;
  padding: 75px 20px;
  text-align: center;
}

.cta h2 {
  font-size: 36px;
  margin-bottom: 15px;
}

.cta p {
  margin-bottom: 25px;
}

.cta .btn {
  background: white;
  color: var(--dark);
  border-color: white;
}

.cta .btn:hover {
  background: transparent;
  color: white;
}

/* CONTACT */

.contact {
  background: var(--light);
  padding: 85px 0;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.contact-info h3,
.contact-form h3 {
  margin-bottom: 22px;
  font-size: 24px;
}

.contact-item {
  background: white;
  padding: 22px;
  margin-bottom: 15px;
  border-left: 4px solid var(--orange);
  overflow-wrap: anywhere;
}

.contact-item strong {
  display: block;
  margin-bottom: 5px;
}

.contact-item a:hover {
  color: var(--orange);
}

.contact-form {
  background: white;
  padding: 32px;
  box-shadow: 0 5px 25px rgba(0,0,0,.05);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 15px;
  border: 1px solid #ddd;
  margin-bottom: 15px;
  font-family: inherit;
  font-size: 14px;
  border-radius: 4px;
}

.contact-form textarea {
  min-height: 140px;
  resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: 1px solid var(--orange);
}

/* FOOTER */

footer {
  background: var(--black);
  color: white;
  padding: 40px 0;
  text-align: center;
}

footer p {
  color: #aaa;
  font-size: 13px;
  margin-top: 10px;
}

footer span {
  color: var(--orange);
}

/* MOBILE */

@media(max-width: 768px) {

  .menu-btn {
    display: block;
  }

  .nav-links {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 82px;
    left: 0;
    width: 100%;
    background: var(--dark);
    padding: 25px;
  }

  .nav-links.active {
    display: flex;
  }

  .service-grid,
  .about-grid,
  .contact-grid,
  .why-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    min-height: 530px;
  }

  .hero p {
    font-size: 16px;
  }

  .section-title {
    font-size: 29px;
  }

  .cta h2 {
    font-size: 28px;
  }

  .btn-outline {
    margin: 12px 0 0;
  }
}
</style>
</head>

